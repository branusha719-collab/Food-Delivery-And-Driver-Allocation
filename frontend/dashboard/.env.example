# Where the browser sends API calls.
#  - Leave EMPTY when the frontend and backend share one origin
#    (local dev proxy, docker-compose, or any reverse proxy that forwards /api).
#  - Set to the backend's public URL (no trailing slash) when hosted separately,
#    e.g. https://food-api.onrender.com  (then set CLIENT_ORIGIN on the backend).
VITE_API_URL=

# Dev server only: where /api is proxied to.
VITE_DEV_PROXY_TARGET=http://localhost:5000

# Sign-in exists in the backend, so keep AUTH=true (the API rejects requests without a token).
# Users / drivers / audit don't exist in the backend yet: keep "false" until the endpoint exists.
# false = the screen shows an empty table and makes no request.
VITE_ENABLE_AUTH=true
VITE_ENABLE_USERS=false
VITE_ENABLE_DRIVERS=false
VITE_ENABLE_AUDIT=false
